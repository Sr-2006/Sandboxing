# ==============================================================================
# Auto-SRE Platform - Environment Configuration Example
# Copy this file to .env and set secure production values.
# NOTE: ENABLE_CHAOS defaults to false for safety (fail-closed).
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=postgres

# Redis In-Memory Cache Authentication
REDIS_PASSWORD=redis_secure_password

# Internal Service Mesh Token (Shared inter-service authorization header)
INTERNAL_SERVICE_TOKEN=internal_mesh_token_change_me_in_prod

# RabbitMQ Message Broker Credentials
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest_secure_password

# JWT Signing Secret (Base64-encoded HMAC-SHA256 key, minimum 256-bit / 32 chars)
JWT_SECRET=c2VjdXJlX2p3dF9zZWNyZXRfa2V5X2Zvcl9hdXRvX3NyZV9wbGF0Zm9ybV8xMjM0NTY3ODkwMTIzNDU2Nzg5MA==

# Grafana Administration Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_password

# Target Host for Orchestration & Traffic
TARGET_HOST=localhost

# Chaos Injection Controls (ENABLE_CHAOS defaults to false)
ENABLE_CHAOS=false
CHAOS_SECRET=CHANGE_ME_chaos_secret
