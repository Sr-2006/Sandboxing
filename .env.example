# ==============================================================================
# Auto-SRE Platform - Environment Configuration Example
# Copy this file to .env and set secure production values
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=postgres

# RabbitMQ Message Broker Credentials
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest_secure_password

# JWT Signing Secret (Base64-encoded HMAC-SHA256 key, minimum 256-bit)
JWT_SECRET=c2VjdXJlX2p3dF9zZWNyZXRfa2V5X2Zvcl9hdXRvX3NyZV9wbGF0Zm9ybV8xMjM0NTY3ODkwMTIzNDU2Nzg5MA==

# Grafana Administration Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_password

# Target Host for Orchestration & Traffic
TARGET_HOST=localhost
ENABLE_CHAOS=true
CHAOS_SECRET=dev-chaos-token
