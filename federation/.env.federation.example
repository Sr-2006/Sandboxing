# ==============================================================================
# Federation URLs — fill in the live tunnel URLs printed by start-tunnel.ps1
# Copy this file to .env.federation and commit/share it with the team.
# Every phase reads OTHER phases' URLs from here (never hardcode localhost
# for cross-laptop calls).
# ==============================================================================

# Laptop A — Phase 1 telemetry/dataset endpoint (serve_dataset.py)
PHASE1_DATASET_URL=https://REPLACE-ME.trycloudflare.com

# Laptop B — Phase 2 ChromaDB (chroma run --port 8000)
PHASE2_CHROMA_URL=https://REPLACE-ME.trycloudflare.com

# Laptop C — Phase 3 FastMCP SSE servers + Ollama
PHASE3_MCP_URL=https://REPLACE-ME.trycloudflare.com
PHASE3_OLLAMA_URL=https://REPLACE-ME.trycloudflare.com

# Laptop D — Phase 4 veto/security gateway
PHASE4_VETO_URL=https://REPLACE-ME.trycloudflare.com
